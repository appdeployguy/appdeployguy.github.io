---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  pageTitle="About"
  metaTitle="About | AppDeploy Guy"
  metaDescription="About AppDeploy Guy — practical technical content focused on application packaging, deployment, Intune, SCCM, and PowerShell."
  activeNav="about"
>
  <style>
    .about-page {
      padding: 1.3rem 2.3rem 1.25rem;
    }

    .about-shell {
      max-width: 860px;
      margin: 0 auto;
    }

    .about-intro {
      margin: 0 0 1.5rem;
      color: var(--muted);
      line-height: 1.75;
      max-width: 68ch;
    }

    .about-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.1rem;
    }

    .about-card {
      border: 1px solid var(--line);
      border-radius: 16px;
      background: color-mix(in srgb, var(--surface) 88%, var(--bg));
      padding: 1.25rem 1.15rem;
      transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
    }

    .about-card:hover {
      transform: translateY(-2px);
      border-color: var(--accent);
      background: color-mix(in srgb, var(--surface) 80%, var(--nav-active));
    }

    .about-card h2 {
      margin: 0 0 0.85rem;
      font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
      font-size: 1.05rem;
      line-height: 1.3;
      color: var(--text);
    }

    .about-card p {
      margin: 0 0 1rem;
      color: var(--muted);
      line-height: 1.7;
    }

    .about-card p:last-child {
      margin-bottom: 0;
    }

    .about-card ul {
      margin: 0;
      padding-left: 1.1rem;
      color: var(--muted);
      line-height: 1.75;
    }

    .about-card li + li {
      margin-top: 0.35rem;
    }

    .about-card a {
      color: var(--link-color);
      text-decoration: none;
    }

    .about-card a:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    @media (max-width: 900px) {
      .about-page {
        padding: 1.25rem 0 0;
      }
    }

    @media (max-width: 720px) {
      .about-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="about-page">
    <div class="about-shell">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <li><a href="/">Home</a></li>
          <li class="breadcrumb-separator" aria-hidden="true">›</li>
          <li aria-current="page">About</li>
        </ol>
      </nav>

      <section class="page-card">
        <header class="page-header">
          <h1>About</h1>
          <p>
            Practical endpoint management content for real-world environments.
          </p>
        </header>

        <p class="about-intro">
          I’m Jeremy Boyes, and I created AppDeploy Guy as a place to document practical
          knowledge from working with Application Packaging, Software Deployment,
          Microsoft Intune, SCCM, and PowerShell.
        </p>

        <div class="about-grid">
          <section class="about-card">
            <h2>What this site is for</h2>
            <p>
              This blog is being built as a focused technical resource for IT
              professionals who want clear, usable information without unnecessary fluff.
            </p>
            <p>
              The aim is to publish practical articles, deployment notes, troubleshooting
              tips, and reusable ideas that help with day-to-day administration and
              modern endpoint management.
            </p>
          </section>

          <section class="about-card">
            <h2>Topics I cover</h2>
            <ul>
              <li>Application packaging and deployment</li>
              <li>Microsoft Intune and endpoint management</li>
              <li>SCCM / Configuration Manager</li>
              <li>PowerShell automation</li>
              <li>Operational tips, lessons learned, and technical walkthroughs</li>
            </ul>
          </section>

          <section class="about-card">
            <h2>Approach</h2>
            <p>
              I prefer documentation that is direct, tested, and easy to apply in
              production. Where possible, posts will focus on practical implementation,
              not just theory.
            </p>
          </section>

          <section class="about-card">
            <h2>Connect</h2>
            <p>
              You can also find me on{" "}
              <a href="https://github.com/appdeployguy" target="_blank" rel="noopener noreferrer">GitHub</a>{" "}
              and{" "}
              <a href="https://www.linkedin.com/in/jeremyboyes/" target="_blank" rel="noopener noreferrer">LinkedIn</a>.
            </p>
          </section>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>